# ----------------------------------------------------
# 1. FILES TO BE IGNORED (Private/Local Work)
# ----------------------------------------------------

# Ignore the local work-in-progress or backup scripts.
# This strictly targets files like 'Preprocessing and dataset matching_updat...'
# using the wildcard to ignore anything containing '_updat'
*updat*.*

# Ignore R language generated binary data files (contain local environment and data)
*.Rdata
.Rhistory

# Ignore R Studio project configuration files
.Rproj.user/

# Ignore compiled report outputs generated by R Markdown
# (Assuming your PDF files are manually uploaded Codebooks, not compiled reports)
*.html
*.docx

# Ignore all temporary/system files for various IDEs
.DS_Store
.vscode/

# ----------------------------------------------------
# 2. IGNORING POTENTIAL SENSITIVE DATA
# ----------------------------------------------------

# If your MRI_varaibles.xlsx contains actual patient data (and not just variable names),
# uncomment the line below to ignore it:
# MRI_varaibles.xlsx

# Ignore local data folders, configuration files, and API keys
/data/
*.env
config.json
*.key
